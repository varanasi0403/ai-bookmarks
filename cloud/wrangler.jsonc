{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-bookmarks-rss",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-bookmarks-rss",
      "database_id": "2deb603b-7b79-4ae4-82dc-b78237b47423",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  }
}
